}

model User {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String            @unique
  displayName       String            @map("display_name")
  passwordHash      String?           @map("password_hash")
  role              String            @default("user")
  isActive          Boolean           @default(true) @map("is_active")
  lastLoginAt       DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  microsoftTenantId String?           @map("microsoft_tenant_id")
  microsoftObjectId String?           @map("microsoft_object_id")
  authSessions      AuthSession[]
  loginAuditEvents  LoginAuditEvent[]

  @@index([role], map: "users_role_idx")
  @@index([isActive], map: "users_active_idx")
  @@map("users")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("auth_sessions")
}

model LoginAuditEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  eventType String   @map("event_type")
  success   Boolean
  reason    String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "login_audit_events_user_created_idx")
  @@index([createdAt(sort: Desc)], map: "login_audit_events_created_idx")
  @@map("login_audit_events")
}

model RagSourceSnapshot {
  sourceId   String   @id @map("source_id")
  uri        String
  title      String
  content    String
  metadata   Json     @default("{}")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  @@map("rag_source_snapshots")
}

model KnowledgeSource {
  id                  String
  uri                 String
  title               String
  owner               String
  accessScope         String                      @default("all_users") @map("access_scope")
  refreshCadence      String                      @default("manual") @map("refresh_cadence")
  connectorKind       String                      @default("legacy") @map("connector_kind")
  connectorConfig     Json                        @default("{}") @map("connector_config")
  allowedContentTypes Json                        @default("[]") @map("allowed_content_types")
  allowedTriggers     Json                        @default("[]") @map("allowed_triggers")
  credentialRef       String?                     @map("credential_ref")
  publicationPolicy   String                      @default("auto_after_validation") @map("publication_policy")
  enabled             Boolean                     @default(true)
  validationConfig    Json                        @default("{}") @map("validation_config")
  currentVersionId    String?                     @map("current_version_id")
  lastSuccessfulRunAt DateTime?                   @map("last_successful_run_at") @db.Timestamptz(6)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  currentVersion      KnowledgeSourceVersion?     @relation("CurrentKnowledgeSourceVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_sources_current_version_fk")
  versions            KnowledgeSourceVersion[]    @relation("KnowledgeSourceVersions")
  schedules           IngestionSchedule[]
  ingestionRuns       IngestionRun[]
  mapBindings         KnowledgeMapSourceBinding[]

  @@id([id])
  @@map("knowledge_sources")
}

model KnowledgeSourceVersion {
  id                String
  sourceId          String                      @map("source_id")
  contentHash       String                      @map("content_hash")
  manifestHash      String?                     @map("manifest_hash")
  status            String                      @default("published")
  producingRunId    String?                     @map("producing_run_id") @db.Uuid
  connectorVersion  String?                     @map("connector_version")
  extractorVersion  String?                     @map("extractor_version")
  sanitizerVersion  String?                     @map("sanitizer_version")
  chunkerVersion    String?                     @map("chunker_version")
  validationSummary Json                        @default("{}") @map("validation_summary")
  upstreamUpdatedAt DateTime                    @map("upstream_updated_at") @db.Timestamptz(6)
  capturedAt        DateTime                    @default(now()) @map("captured_at") @db.Timestamptz(6)
  publishedAt       DateTime?                   @map("published_at") @db.Timestamptz(6)
  rejectedAt        DateTime?                   @map("rejected_at") @db.Timestamptz(6)
  metadata          Json                        @default("{}")
  source            KnowledgeSource             @relation("KnowledgeSourceVersions", fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currentForSources KnowledgeSource[]           @relation("CurrentKnowledgeSourceVersion")
  documents         KnowledgeSourceDocument[]
  mapBindings       KnowledgeMapSourceBinding[]

  @@id([id])
  @@index([sourceId, contentHash], map: "knowledge_source_versions_source_content_idx")
  @@map("knowledge_source_versions")
}

model KnowledgeSourceDocument {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceVersionId   String                 @map("source_version_id")
  documentKey       String                 @map("document_key")
  canonicalUri      String                 @map("canonical_uri")
  title             String
  mediaType         String                 @map("media_type")
  contentHash       String                 @map("content_hash")
  content           String
  artifactRef       String?                @map("artifact_ref")
  upstreamUpdatedAt DateTime?              @map("upstream_updated_at") @db.Timestamptz(6)
  etag              String?
  accessScope       String                 @default("all_users") @map("access_scope")
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceVersion     KnowledgeSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sourceVersionId, documentKey])
  @@index([contentHash], map: "knowledge_source_documents_content_hash_idx")
  @@map("knowledge_source_documents")
