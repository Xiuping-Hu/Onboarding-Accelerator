model IngestionSchedule {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId          String          @map("source_id")
  cronExpression    String          @map("cron_expression")
  timezone          String
  enabled           Boolean         @default(true)
  nextRunAt         DateTime        @map("next_run_at") @db.Timestamptz(6)
  lastEnqueuedAt    DateTime?       @map("last_enqueued_at") @db.Timestamptz(6)
  misfirePolicy     String          @default("run_once") @map("misfire_policy")
  maxRuntimeSeconds Int             @default(900) @map("max_runtime_seconds")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  source            KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sourceId])
  @@index([enabled, nextRunAt], map: "ingestion_schedules_due_idx")
  @@map("ingestion_schedules")
}

model IngestionRun {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId           String              @map("source_id")
  triggerType        String              @map("trigger_type")
  triggerRef         String?             @map("trigger_ref")
  requestedBy        String?             @map("requested_by")
  idempotencyKey     String              @unique @map("idempotency_key")
  scheduledFor       DateTime?           @map("scheduled_for") @db.Timestamptz(6)
  availableAt        DateTime            @default(now()) @map("available_at") @db.Timestamptz(6)
  status             String              @default("queued")
  attempt            Int                 @default(0)
  workerId           String?             @map("worker_id")
  leaseExpiresAt     DateTime?           @map("lease_expires_at") @db.Timestamptz(6)
  heartbeatAt        DateTime?           @map("heartbeat_at") @db.Timestamptz(6)
  startedAt          DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  candidateVersionId String?             @map("candidate_version_id")
  documentCount      Int                 @default(0) @map("document_count")
  characterCount     Int                 @default(0) @map("character_count")
  chunkCount         Int                 @default(0) @map("chunk_count")
  embeddingCount     Int                 @default(0) @map("embedding_count")
  safeErrorCode      String?             @map("safe_error_code")
  safeErrorMessage   String?             @map("safe_error_message")
  validationSummary  Json                @default("{}") @map("validation_summary")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  source             KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events             IngestionRunEvent[]

  @@index([status, availableAt, createdAt], map: "ingestion_runs_queue_idx")
  @@index([sourceId, createdAt(sort: Desc)], map: "ingestion_runs_source_created_idx")
  @@index([sourceId, leaseExpiresAt], map: "ingestion_runs_source_lease_idx")
  @@map("ingestion_runs")
}

model IngestionRunEvent {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId      String       @map("run_id") @db.Uuid
  eventType  String       @map("event_type")
  reasonCode String?      @map("reason_code")
  inputHash  String?      @map("input_hash")
  outputHash String?      @map("output_hash")
  metadata   Json         @default("{}")
  eventAt    DateTime     @default(now()) @map("event_at") @db.Timestamptz(6)
  run        IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([runId, eventAt], map: "ingestion_run_events_run_event_idx")
  @@map("ingestion_run_events")
}

model KnowledgeMap {
  id                 String
  slug               String                @unique
  title              String
  description        String?
  tenantId           String?               @map("tenant_id")
  defaultAccessScope String                @default("all_users") @map("default_access_scope")
  currentVersionId   String?               @map("current_version_id")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  currentVersion     KnowledgeMapVersion?  @relation("CurrentKnowledgeMapVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_maps_current_version_fk")
  versions           KnowledgeMapVersion[] @relation("KnowledgeMapVersions")

  @@id([id])
  @@map("knowledge_maps")
}

model KnowledgeMapVersion {
  id             String
  mapId          String                       @map("map_id")
  versionNumber  Int                          @map("version_number")
  status         String
  changeNote     String?                      @map("change_note")
  createdBy      String                       @map("created_by")
  publishedBy    String?                      @map("published_by")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime?                    @map("published_at") @db.Timestamptz(6)
  map            KnowledgeMap                 @relation("KnowledgeMapVersions", fields: [mapId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currentForMaps KnowledgeMap[]               @relation("CurrentKnowledgeMapVersion")
  nodes          KnowledgeMapNode[]
  edges          KnowledgeMapEdge[]
  sourceBindings KnowledgeMapSourceBinding[]
  evidenceHealth KnowledgeMapEvidenceHealth[]
  suggestions    KnowledgeMapSuggestion[]
  feedback       KnowledgeMapFeedback[]

  @@id([id])
  @@unique([mapId, versionNumber])
  @@map("knowledge_map_versions")
}

model KnowledgeMapNode {
  id                          String
  mapVersionId                String                      @map("map_version_id")
  stableKey                   String                      @map("stable_key")
  kind                        String
  title                       String
  summary                     String
  owner                       String?
  displayOrder                Int                         @default(0) @map("display_order")
  accessScope                 String                      @default("all_users") @map("access_scope")
  controllingDocumentRequired Boolean                     @default(false) @map("controlling_document_required")
  mapVersion                  KnowledgeMapVersion         @relation(fields: [mapVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outgoingEdges               KnowledgeMapEdge[]          @relation("KnowledgeMapEdgeFrom")
  incomingEdges               KnowledgeMapEdge[]          @relation("KnowledgeMapEdgeTo")
  sourceBindings              KnowledgeMapSourceBinding[]
  feedback                    KnowledgeMapFeedback[]

  @@id([id])
  @@unique([mapVersionId, stableKey])
  @@map("knowledge_map_nodes")
}

model KnowledgeMapEdge {
  id             String
  mapVersionId   String                      @map("map_version_id")
  fromNodeId     String                      @map("from_node_id")
  toNodeId       String                      @map("to_node_id")
  relationship   String
  rationale      String?
  displayOrder   Int                         @default(0) @map("display_order")
  mapVersion     KnowledgeMapVersion         @relation(fields: [mapVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromNode       KnowledgeMapNode            @relation("KnowledgeMapEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toNode         KnowledgeMapNode            @relation("KnowledgeMapEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sourceBindings KnowledgeMapSourceBinding[]

  @@id([id])
  @@map("knowledge_map_edges")
}

model KnowledgeMapSourceBinding {
  id              String
  mapVersionId    String                  @map("map_version_id")
  nodeId          String?                 @map("node_id")
  edgeId          String?                 @map("edge_id")
  sourceId        String                  @map("source_id")
  sourceVersionId String?                 @map("source_version_id")
  sectionKey      String?                 @map("section_key")
  evidenceRole    String                  @map("evidence_role")
  mapVersion      KnowledgeMapVersion     @relation(fields: [mapVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  node            KnowledgeMapNode?       @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  edge            KnowledgeMapEdge?       @relation(fields: [edgeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  source          KnowledgeSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceVersion   KnowledgeSourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([id])
  @@map("knowledge_map_source_bindings")
}

model KnowledgeMapEvidenceHealth {
